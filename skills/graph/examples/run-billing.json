{
  "kind": "sequence",
  "title": "Run and billing",
  "subtitle": "A run only starts when the balance covers it",
  "participants": [
    {
      "id": "user",
      "label": "User / Scheduler",
      "external": true
    },
    {
      "id": "app",
      "label": "App"
    },
    {
      "id": "llm",
      "label": "Model API",
      "external": true
    }
  ],
  "edges": [
    {
      "from": "user",
      "to": "app",
      "label": "start a run"
    },
    {
      "from": "app",
      "to": "llm",
      "label": "prompts and judging"
    }
  ],
  "steps": [
    {
      "from": "user",
      "to": "app",
      "label": "run now (or schedule fires)"
    },
    {
      "from": "app",
      "to": "app",
      "label": "balance >= cost per run?",
      "kind": "self"
    },
    {
      "fragment": "alt",
      "branches": [
        {
          "label": "not enough",
          "steps": [
            {
              "from": "app",
              "to": "user",
              "label": "paused: low balance",
              "kind": "reply"
            }
          ]
        },
        {
          "label": "enough",
          "steps": [
            {
              "from": "app",
              "to": "app",
              "label": "hold estimated cost",
              "kind": "self"
            },
            {
              "fragment": "loop",
              "label": "each prompt x engine",
              "steps": [
                {
                  "from": "app",
                  "to": "llm",
                  "label": "ask prompt",
                  "kind": "call-return",
                  "note": "The return carries the answer and its sources."
                },
                {
                  "from": "app",
                  "to": "llm",
                  "label": "judge mentions"
                }
              ]
            },
            {
              "from": "app",
              "to": "app",
              "label": "settle actual cost, release the rest",
              "kind": "self",
              "emphasis": true
            },
            {
              "from": "app",
              "to": "user",
              "label": "results updated",
              "kind": "reply"
            }
          ]
        }
      ]
    }
  ]
}
